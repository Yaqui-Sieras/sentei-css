{
  "name": "sentei-css",
  "version": "0.1.1",
  "description": "Un CSS Reset mas unos estilos base para desarrollar sin preocuparte desde el principio en los estilos",
  "type": "module",
  "main": "public/styles/sentei.css",
  "style": "public/styles/sentei.css",
  "exports": {
    ".": "./public/styles/sentei.css",
    "./public/styles/sentei.css": "./public/styles/sentei.css"
  },
  "files": [
    "public/styles/sentei.css",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://yaqui-sieras.github.io/sentei-css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yaqui-Sieras/sentei-css.git"
  },
  "bugs": {
    "url": "https://github.com/Yaqui-Sieras/sentei-css/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "keywords": [
    "css",
    "reset",
    "styles"
  ],
  "author": "Yaqui-Sieras",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3"
  }
}
