---
// src/components/shared/NavBarPage.astro
import { NAV_ITEMS } from '@/constants/routes';

const currentPath = Astro.url.pathname;
---
<nav class="navbar_page">
  {NAV_ITEMS.map((item) => {
    // Comprobamos si la ruta actual coincide exactamente con el href del item
    const isActive = currentPath === item.href;

    return (
      <a 
        href={item.href} 
        class:list={[
          'navbar_page__link',
          { 'is-active': isActive }
        ]}
      >
        {item.title}
      </a>
    );
  })}
</nav>

<style>
  .navbar_page {
    width: 50%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: start;
    gap: 1.5rem;
  }

  .navbar_page__link {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    &:hover {
      color: #00d26a; /* Tu color de acento */
    }
  }

  .is-active {
    color: #00d26a;
  }
</style>